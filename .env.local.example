# 이메일 알림 설정 (Gmail 기준)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password   # Gmail 앱 비밀번호 (2단계 인증 후 발급)

# 알림 받을 이메일 (본인 이메일)
ADMIN_EMAIL=jymanager@gmail.com

# 나중에 DB 연동 시 추가
# DATABASE_URL=

# 페이앱 단발성 결제
PAYAPP_USER_ID=   # 페이앱 아이디
PAYAPP_KEY=       # 페이앱 API 키
